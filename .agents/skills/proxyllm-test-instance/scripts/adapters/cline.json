{
  "name": "cline",
  "label": "Cline CLI",
  "tier": "tier2",
  "command": "cline",
  "install": "npm install -g cline@3.0.73",
  "tested": "3.0.73",
  "runnable": true,
  "env_keep": ["PATH", "LANG", "LC_ALL", "TERM", "TMPDIR", "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS"],
  "scrub_env": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL"],
  "files": {
    "{{DATA_DIR}}/cline/settings/providers.json": "{\"version\":1,\"lastUsedProvider\":\"openai-compatible\",\"modes\":{},\"providers\":{\"openai-compatible\":{\"settings\":{\"provider\":\"openai-compatible\",\"apiKey\":\"{{CLIENT_KEY}}\",\"model\":\"{{MODEL}}\",\"baseUrl\":\"{{BASE_URL}}/v1\"},\"updatedAt\":\"2026-10-25T00:00:00.000Z\",\"tokenSource\":\"manual\"}}}"
  },
  "args": ["{{PROMPT}}", "-P", "openai", "-m", "{{MODEL}}", "--json", "--auto-approve", "true", "--config", "{{CONFIG_DIR}}", "--data-dir", "{{DATA_DIR}}/cline"],
  "canary": ["~/.cline"]
}
