{
  "name": "goose",
  "label": "Goose",
  "tier": "recommended",
  "command": "goose",
  "install": "curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh | bash",
  "tested": "1.56.0",
  "runnable": true,
  "env_keep": ["PATH", "LANG", "LC_ALL", "TERM", "TMPDIR", "SSL_CERT_FILE", "SSL_CERT_DIR"],
  "scrub_env": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL"],
  "env": {
    "GOOSE_PATH_ROOT": "{{DATA_DIR}}/goose",
    "GOOSE_DISABLE_KEYRING": "1",
    "GOOSE_PROVIDER": "openai",
    "GOOSE_MODEL": "{{MODEL}}",
    "OPENAI_HOST": "{{BASE_URL}}",
    "OPENAI_BASE_PATH": "v1/chat/completions",
    "OPENAI_API_KEY": "{{CLIENT_KEY}}"
  },
  "args": ["run", "--no-session", "-t", "{{PROMPT}}"],
  "canary": ["~/.config/goose"]
}
