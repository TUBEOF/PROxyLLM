# Normalize all text files to LF in the repository. Working-copy line
# endings follow core.autocrlf; CI and Docker builds get LF regardless.
* text=auto eol=lf

# Windows scripts keep CRLF so cmd/powershell execute them cleanly.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary