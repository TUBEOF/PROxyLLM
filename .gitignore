# Build artifacts
/proxyllm
/proxyllm.exe
/bin/
/dist/

# Test artifacts
*.test
*.out
coverage.txt

# Data & secrets — never commit
/data/
*.db
*.db-shm
*.db-wal
*.key
.env
.env.*

# Node / WebUI
node_modules/
webui/node_modules/
# dist is a build artifact EXCEPT the committed placeholder index.html —
# the go:embed directive in webui/embed.go requires the directory to
# exist with at least one embeddable file, so a fresh clone builds
# without a Node toolchain. CI builds the real assets over it.
webui/dist/*
!webui/dist/index.html

# Go workspace
go.work
go.work.sum

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db