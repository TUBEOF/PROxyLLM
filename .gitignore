# Build artifacts
/proxyllm
/proxyllm.exe
/bin/
/dist/

# Test artifacts
*.test
*.out
coverage.txt

# Data & secrets — never commit
/data/
*.db
*.db-shm
*.db-wal
*.key
.env
.env.*

# Node / WebUI
node_modules/
webui/node_modules/
# dist is a build artifact EXCEPT the committed placeholder index.html —
# the go:embed directive in webui/embed.go requires the directory to
# exist with at least one embeddable file, so a fresh clone builds
# without a Node toolchain. CI builds the real assets over it.
webui/dist/*
!webui/dist/index.html

# Go workspace
go.work
go.work.sum

# Agent tooling — local working files, never part of the project.
.live-cli/
.aider.chat.history.md
.aider.input.history
# Project skills ship with the repo in .agents/skills/ (the cross-harness
# Agent Skills path). .claude/skills/ holds only symlinks to those directories
# so Claude Code discovers the same files; nothing there is a second copy.
.claude/*
!.claude/skills/

# Python bytecode from the test-instance harness (scripts run with -I, but
# direct imports can still leave a cache).
__pycache__/
CLAUDE.md
.codegraph/
.remember/
.superpowers/
docs/superpowers/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
# Playwright fixture-server binary + test artifacts (built in CI / locally)
webui/e2e/fixturesrv-bin
webui/e2e/fixturesrv-bin.exe
webui/e2e/.artifacts/
webui/e2e/.artifacts-empty/
webui/playwright-report/
# Go build outputs at the repo root: the .exe line was not enough —
# `go build ./webui/e2e/fixturesrv` from the root produced /fixturesrv,
# which got committed (174825a) and grew the pack by 19 MB.
/fixturesrv
/fixturesrv-bin
/fixturesrv.exe
