{
  "name": "claude-code",
  "label": "Claude Code",
  "tier": "core",
  "command": "claude",
  "install": "npm install -g @anthropic-ai/claude-code",
  "tested": "latest",
  "runnable": true,
  "env_keep": [
    "PATH",
    "LANG",
    "LC_ALL",
    "TERM",
    "TMPDIR",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS"
  ],
  "scrub_env": [
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL"
  ],
  "env": {
    "CLAUDE_CONFIG_DIR": "{{CONFIG_DIR}}/claude",
    "ANTHROPIC_BASE_URL": "{{BASE_URL}}",
    "ANTHROPIC_AUTH_TOKEN": "{{CLIENT_KEY}}",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "args": [
    "-p",
    "{{PROMPT}}",
    "--output-format",
    "json"
  ],
  "canary": [
    "~/.claude",
    "~/.claude.json"
  ],
  "canary_skip_env": "CLAUDECODE",
  "canary_note": "Canary is skipped when the harness runs inside Claude Code: the parent session writes ~/.claude and ~/.claude.json concurrently. Isolation is enforced by CLAUDE_CONFIG_DIR plus a fresh HOME; the child must write only under the run directory.",
  "features": {
    "tools": {
      "args": [
        "-p",
        "{{PROMPT}}",
        "--output-format",
        "json",
        "--allowedTools",
        "Read"
      ]
    },
    "web_search": {
      "args": [
        "-p",
        "{{PROMPT}}",
        "--output-format",
        "json",
        "--allowedTools",
        "WebSearch",
        "WebFetch",
        "Read"
      ]
    }
  },
  "skip_reasons": {
    "vision": "Claude Code's Read did not attach the image to the model request",
    "web_fetch": "the model intermittently keeps the client tool name (WebFetch), which the CLI then runs client-side"
  }
}
