{
  "name": "continue",
  "label": "Continue CLI",
  "tier": "tier2",
  "command": "cn",
  "install": "npm install -g @continuedev/cli@1.5.47",
  "tested": "1.5.47",
  "runnable": true,
  "env_keep": [
    "PATH",
    "LANG",
    "LC_ALL",
    "TERM",
    "TMPDIR",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS"
  ],
  "scrub_env": [
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL"
  ],
  "env": {
    "CONTINUE_CLI_ENABLE_TELEMETRY": "0",
    "CONTINUE_CLI_AUTO_UPDATED": "1",
    "NODE_USE_ENV_PROXY": "1",
    "HTTP_PROXY": "http://127.0.0.1:9",
    "HTTPS_PROXY": "http://127.0.0.1:9"
  },
  "files": {
    "{{CONFIG_DIR}}/continue/config.yaml": "name: proxyllm\nversion: 0.0.1\nschema: v1\nmodels:\n  - name: proxy-chat\n    provider: openai\n    model: {{MODEL}}\n    apiBase: {{BASE_URL}}/v1\n    apiKey: {{CLIENT_KEY}}\n    useResponsesApi: false\n",
    "{{HOME}}/.continue/config.yaml": "name: proxyllm\nversion: 0.0.1\nschema: v1\nmodels:\n  - name: proxy-chat\n    provider: openai\n    model: {{MODEL}}\n    apiBase: {{BASE_URL}}/v1\n    apiKey: {{CLIENT_KEY}}\n    useResponsesApi: false\n",
    "{{HOME}}/.continue/.onboarding_complete": "2026-01-01T00:00:00.000Z"
  },
  "args": [
    "-p",
    "{{PROMPT}}",
    "--config",
    "{{CONFIG_DIR}}/continue/config.yaml",
    "--format",
    "json"
  ],
  "canary": [
    "~/.continue"
  ],
  "features": {
    "tools": {},
    "web_fetch": {},
    "multi_turn": {
      "turns": [
        [
          "-p",
          "{{PROMPT}}",
          "--config",
          "{{CONFIG_DIR}}/continue/config.yaml",
          "--format",
          "json"
        ],
        [
          "-p",
          "{{PROMPT}}",
          "--resume",
          "--config",
          "{{CONFIG_DIR}}/continue/config.yaml",
          "--format",
          "json"
        ]
      ]
    }
  },
  "skip_reasons": {
    "vision": "Continue CLI has no headless image attachment",
    "web_search": "Continue CLI exposes no web_search tool"
  }
}
