{
  "name": "aider",
  "label": "Aider",
  "tier": "recommended",
  "command": "aider",
  "install": "uv tool install aider-chat --python 3.12",
  "tested": "latest",
  "runnable": true,
  "env_keep": [
    "PATH",
    "LANG",
    "LC_ALL",
    "TERM",
    "TMPDIR",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR"
  ],
  "scrub_env": [
    "OPENAI_API_KEY",
    "OPENAI_API_BASE",
    "OPENAI_BASE_URL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL"
  ],
  "env": {
    "OPENAI_API_BASE": "{{BASE_URL}}/v1",
    "OPENAI_API_KEY": "{{CLIENT_KEY}}",
    "AIDER_NO_AUTO_COMMITS": "1"
  },
  "files": {
    "{{CONFIG_DIR}}/aider/aider.conf.yml": "openai-api-base: \"{{BASE_URL}}/v1\"\nopenai-api-key: \"{{CLIENT_KEY}}\"\n"
  },
  "args": [
    "--config",
    "{{CONFIG_DIR}}/aider/aider.conf.yml",
    "--model",
    "openai/{{MODEL}}",
    "--message",
    "{{PROMPT}}",
    "--exit",
    "--yes-always",
    "--no-auto-commits",
    "--no-git",
    "--no-check-update"
  ],
  "canary": [
    "~/.aider.conf.yml",
    "~/.aider"
  ]
}
