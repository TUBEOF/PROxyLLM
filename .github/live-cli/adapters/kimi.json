{
  "name": "kimi",
  "label": "Kimi Code CLI",
  "tier": "recommended",
  "command": "kimi",
  "install": "npm install -g @moonshot-ai/kimi-code@2.4.1",
  "tested": "2.4.1",
  "runnable": true,
  "env_keep": [
    "PATH",
    "LANG",
    "LC_ALL",
    "TERM",
    "TMPDIR",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS"
  ],
  "scrub_env": [
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL",
    "KIMI_API_KEY",
    "KIMI_BASE_URL",
    "KIMI_CODE_HOME",
    "KIMI_CODE_TRUST_WORKSPACE"
  ],
  "files": {
    "{{HOME}}/.kimi-code/config.toml": "default_model = \"proxy-chat\"\ntelemetry = false\n\n[providers.proxyllm]\ntype = \"openai\"\nbase_url = \"{{BASE_URL}}/v1\"\napi_key = \"{{CLIENT_KEY}}\"\n\n[models.proxy-chat]\nprovider = \"proxyllm\"\nmodel = \"{{MODEL}}\"\nmax_context_size = 128000\n"
  },
  "args": [
    "-p",
    "{{PROMPT}}",
    "-m",
    "proxy-chat",
    "--output-format",
    "text"
  ],
  "canary": [
    "~/.kimi",
    "~/.kimi-code",
    "~/.config/kimi"
  ],
  "features": {
    "tools": {},
    "web_fetch": {},
    "multi_turn": {
      "turns": [
        [
          "-p",
          "{{PROMPT}}",
          "-m",
          "proxy-chat",
          "--output-format",
          "text"
        ],
        [
          "-p",
          "{{PROMPT}}",
          "-c",
          "-m",
          "proxy-chat",
          "--output-format",
          "text"
        ]
      ]
    }
  },
  "skip_reasons": {
    "web_search": "Kimi Code exposes no web_search tool",
    "vision": "Kimi Code's Read returns text for an image path"
  }
}
