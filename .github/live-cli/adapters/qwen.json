{
  "name": "qwen",
  "label": "Qwen Code",
  "tier": "tier2",
  "command": "qwen",
  "install": "npm install -g @qwen-code/qwen-code",
  "tested": "latest",
  "runnable": true,
  "env_keep": [
    "PATH",
    "LANG",
    "LC_ALL",
    "TERM",
    "TMPDIR",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS"
  ],
  "scrub_env": [
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_MODEL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL"
  ],
  "env": {
    "OPENAI_BASE_URL": "{{BASE_URL}}/v1",
    "OPENAI_API_KEY": "{{CLIENT_KEY}}",
    "OPENAI_MODEL": "{{MODEL}}"
  },
  "args": [
    "-p",
    "{{PROMPT}}"
  ],
  "canary": [
    "~/.qwen"
  ],
  "features": {
    "tools": {}
  },
  "skip_reasons": {
    "vision": "Qwen Code has no headless image attachment",
    "web_search": "Qwen Code's web search is Google-grounded, not in the one-shot tool set",
    "web_fetch": "Qwen Code does not expose a web tool to the model in one-shot mode"
  }
}
